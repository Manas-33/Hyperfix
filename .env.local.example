# ---- Copy this file to ".env.local" and fill in your values ----
# (.env.local is git-ignored and never committed)

# Server-side only. Your Anthropic key stays on the server, never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: default model for AI actions
ANTHROPIC_MODEL=claude-sonnet-4-6

# Who may use the AI endpoint (comma-separated emails). Only these signed-in
# Google accounts can spend your Anthropic credits.
ALLOWED_EMAILS=you@example.com

# Firebase web config (public keys, safe to expose to the browser).
# Firebase console -> Project settings -> Your apps -> Web app -> Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ALLOWED_EMAILS=